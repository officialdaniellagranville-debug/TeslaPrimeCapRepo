"zu\"><img data-gt-lazy-src=\"https://cdn.gtranslate.net/flags/svg/zu.svg\" alt=\"zu\"> Zulu</a></div><div class=\"gt-selected\"><div class=\"gt-current-lang\"><img src=\"https://cdn.gtranslate.net/flags/svg/en-us.svg\" alt=\"en\"> <span class=\"gt-lang-code\">en</span> <span class=\"gt_float_switcher-arrow\"></span></div></div></div></div></div>\n<script>window.gtranslateSettings={\"default_language\":\"en\",\"detect_browser_language\":true,\"wrapper_selector\":\".gtranslate_wrapper\",\"alt_flags\":{\"en\":\"usa\"}}</script>\n<script src=\"https://cdn.gtranslate.net/widgets/latest/float.js\" defer=\"\"></script>\n<script>\nfunction toggleDM(){\n  var d=document.documentElement.classList.toggle('dark');\n  localStorage.setItem('darkMode',d);\n  applyDM(d);\n}\nfunction applyDM(d){\n  var b=document.getElementById('dmToggle');\n  var r=document.querySelector('.right');\n  var c=document.querySelector('.card');\n  var h2s=document.querySelectorAll('.card h2');\n  var labels=document.querySelectorAll('.card label');\n  var spans=document.querySelectorAll('.card span');\n  var links=document.querySelectorAll('.card a');\n  var inps=document.querySelectorAll('.card .inp');\n  var divider=document.querySelector('.card span[style*=\"background:#fff\"]');\n  var btnOutline=document.querySelector('.btn-outline');\n  if(d){\n    document.body.style.background='#0f172a';\n    if(r){r.style.background='#0f172a'}\n    if(b){b.style.background='#1e293b';b.style.borderColor='#334155';b.style.color='#94a3b8'}\n    if(c){c.style.background='#1e293b';c.style.borderColor='#334155';c.style.color='#e2e8f0';c.style.boxShadow='0 10px 40px rgba(0,0,0,0.3)'}\n    h2s.forEach(function(el){el.style.color='#f1f5f9'});\n    labels.forEach(function(el){el.style.color='#94a3b8'});\n    inps.forEach(function(el){el.style.background='#0f172a';el.style.borderColor='#334155';el.style.color='#e2e8f0'});\n    if(divider)divider.style.background='#1e293b';\n    if(btnOutline){btnOutline.style.background='#0f172a';btnOutline.style.borderColor='#334155';btnOutline.style.color='#e2e8f0'}\n  } else {\n    document.body.style.background='#f8fafc';\n    if(r){r.style.background='#f8fafc'}\n    if(b){b.style.background='#f1f5f9';b.style.borderColor='#e2e8f0';b.style.color='#94a3b8'}\n    if(c){c.style.background='#fff';c.style.borderColor='#e2e8f0';c.style.color='';c.style.boxShadow=''}\n    h2s.forEach(function(el){el.style.color=''});\n    labels.forEach(function(el){el.style.color=''});\n    inps.forEach(function(el){el.style.background='';el.style.borderColor='';el.style.color=''});\n    if(divider)divider.style.background='#fff';\n    if(btnOutline){btnOutline.style.background='';btnOutline.style.borderColor='';btnOutline.style.color=''}\n  }\n}\n(function(){if(localStorage.getItem('darkMode')==='true'){document.documentElement.classList.add('dark');applyDM(true)}})();\n\nfunction handleLogin(e){\n  e.preventDefault();\n  var form=document.getElementById('loginForm');\n  var btn=form.querySelector('button[type=submit]');\n  var card=document.getElementById('loginCard');\n  var errBox=document.getElementById('loginError');\n  var email=form.querySelector('[name=email]').value;\n  var password=form.querySelector('[name=password]').value;\n\n  // Hide previous error\n  errBox.style.display='none';\n\n  // Disable button\n  btn.innerHTML='<svg style=\"animation:spin 1s linear infinite;width:18px;height:18px;margin-right:8px\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"white\" stroke-width=\"4\" fill=\"none\" opacity=\"0.25\"/><path fill=\"white\" opacity=\"0.75\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z\"/></svg> Signing in...';\n  btn.disabled=true;\n  btn.style.opacity='0.7';\n\n  fetch('/login',{\n    method:'POST',\n    headers:{'Content-Type':'application/json'},\n    body:JSON.stringify({email:email,password:password})\n  })\n  .then(function(r){if(r.redirected){window.location.href=r.url;return null}return r.json()})\n  .then(function(data){\n    if(!data)return;\n    if(data.success){\n      window.location.href=data.redirect||'/dashboard/pin';\n    } else {\n      // Shake the card\n      card.classList.add('shake');\n      setTimeout(function(){card.classList.remove('shake')},500);\n\n      // Show error\n      errBox.className='error-toast';\n      errBox.innerHTML='<i class=\"fas fa-exclamation-circle\"></i> '+(data.message||'Invalid credentials');\n      errBox.style.display='flex';\n\n      // Make inputs red briefly\n      var inps=form.querySelectorAll('.inp');\n      inps.forEach(function(inp){\n        inp.style.borderColor='#fecaca';\n        setTimeout(function(){inp.style.borderColor=''},2000);\n      });\n\n      // Reset button\n      btn.innerHTML='<i class=\"fas fa-sign-in-alt\"></i> Sign In to Account';\n      btn.disabled=false;\n      btn.style.opacity='1';\n    }\n  })\n  .catch(function(){\n    btn.innerHTML='<i class=\"fas fa-sign-in-alt\"></i> Sign In to Account';\n    btn.disabled=false;\n    btn.style.opacity='1';\n    errBox.className='error-toast';\n    errBox.innerHTML='<i class=\"fas fa-exclamation-circle\"></i> Network error. Please try again.';\n    errBox.style.display='flex';\n    card.classList.add('shake');\n    setTimeout(function(){card.classList.remove('shake')},500);\n  });\n  return false;\n}\n</script>\n<style>@keyframes spin{to{transform:rotate(360deg)}}</style>\n\n</body></html>",
